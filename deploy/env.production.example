# Copy to /opt/invoiceflow/.env on the server and fill in the blanks.
# Never commit the real file. Replace dXXXXXXXXXXXXX.cloudfront.net with your distribution's domain.

APP_NAME=InvoiceFlow
APP_ENV=production
APP_DEBUG=false
# Generate with: docker run --rm ghcr.io/sajadk/invoiceflow-api php artisan key:generate --show
APP_KEY=
APP_TIMEZONE=Asia/Dubai
APP_URL=https://dXXXXXXXXXXXXX.cloudfront.net
FRONTEND_URL=https://dXXXXXXXXXXXXX.cloudfront.net

# Logs go to Docker (docker compose logs api), which rotates them
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# The invoiceflow database and user on the shared RDS instance
DB_CONNECTION=mysql
DB_HOST=car-listing-db.cfcisewequ3p.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=invoiceflow
DB_USERNAME=invoiceflow
DB_PASSWORD=

# Sanctum SPA cookies. The browser only ever sees the CloudFront domain.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=dXXXXXXXXXXXXX.cloudfront.net

CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Same value as the X-Origin-Verify custom header on the CloudFront API origin.
# Generate with: openssl rand -hex 32
ORIGIN_SECRET=
